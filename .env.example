# Copy to .env and supply your own values before starting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional publisher account: leave BOTH blank to disable, or set both.
PUBLISHER_USERNAME=
PUBLISHER_PASSWORD=
SESSION_SECRET=
SIGNAGE_API_TOKEN=
# false ONLY for localhost HTTP testing; true behind HTTPS reverse proxy.
COOKIE_SECURE=true
MAX_UPLOAD_MB=1024
BIND_ADDRESS=127.0.0.1
PORT=8080
