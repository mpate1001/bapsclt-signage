# Copy to /etc/bapsclt-signage/pi.env and chmod 600. Never commit real secrets.
SIGNAGE_URL=https://bapsclt.datavault.digital
SIGNAGE_API_TOKEN=
SIGNAGE_DATA_DIR=/home/admin/bapsclt-signage-data
SIGNAGE_POLL_SECONDS=30
SIGNAGE_MAX_VIDEO_BYTES=2000000000
# Optional stable device name; defaults to hostname (letters, digits, dots, hyphens, underscores).
# SIGNAGE_DEVICE_ID=signage-pi-01
